# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*
*/node_modules/
catalog-service/docs/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows / Linux
Thumbs.db
Desktop.ini
*~

# Editors and IDEs
.idea/
*.iml
**/.vscode/*
!**/.vscode/extensions.json
*.swp
*.swo

# Environment and secrets (keep the .env.example files)
.env
.env.*
!.env.example
*.pem
*.key

# Claude Code local settings (shared skills in .claude/skills stay tracked)
**/.claude/settings.local.json

# Python bytecode (e.g. from the scripts of the skills in .claude/skills)
__pycache__/
*.py[cod]

# Office lock files
~$*
