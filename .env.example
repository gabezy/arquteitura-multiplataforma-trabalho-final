# Copied to .env by `make env`; __GENERATE__ becomes a random value.
# Keys already in .env are kept as they are, so the generated values survive later runs.

# Keycloak and Grafana admin logins: local tool access, not application secrets.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=__GENERATE__
COMPLIANCE_DB_NAME=compliance
COMPLIANCE_DB_USER=compliance
COMPLIANCE_DB_PASSWORD=__GENERATE__

# Secret of the bff-gateway client in the Keycloak realm.
BFF_CLIENT_SECRET=__GENERATE__

# Vault (dev mode): root token used by vault-init, and the AppRole of each service.
VAULT_ROOT_TOKEN=__GENERATE__
CATALOG_VAULT_ROLE_ID=__GENERATE__
CATALOG_VAULT_SECRET_ID=__GENERATE__
COMPLIANCE_VAULT_ROLE_ID=__GENERATE__
COMPLIANCE_VAULT_SECRET_ID=__GENERATE__
BFF_VAULT_ROLE_ID=__GENERATE__
BFF_VAULT_SECRET_ID=__GENERATE__

# Host ports, when 8080 or 3000 are taken.
# BFF_PORT=8080
# GRAFANA_PORT=3000
