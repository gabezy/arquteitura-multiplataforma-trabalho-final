PORT=8087
LOG_LEVEL=info
OTEL_SERVICE_NAME=marketplace-gateway
OTEL_COLLECTOR_URL=http://localhost:4318
DATABASE_URL=postgresql://marketplace:marketplace@localhost:5436/marketplace
KAFKA_BROKERS=localhost:9092

# Marketplaces: the WireMock simulators (inside a compose container: http://wiremock:8080/<marketplace>)
AMAZON_BASE_URL=http://localhost:8089/amazon
AMAZON_MARKETPLACE_ID=A2Q3Y263D00KWC
MERCADO_LIVRE_BASE_URL=http://localhost:8089/mercadolivre
MERCADO_LIVRE_SELLER_ID=2000
SHOPEE_BASE_URL=http://localhost:8089/shopee
SHOPEE_SHOP_ID=1001

# Calls to the marketplaces (ADR-0009): timeout per attempt, attempts in total, waits between them, circuit breaker
MARKETPLACE_TIMEOUT_MS=3000
MARKETPLACE_MAX_ATTEMPTS=3
MARKETPLACE_BACKOFF_BASE_MS=200
MARKETPLACE_BACKOFF_MAX_MS=2000
MARKETPLACE_BREAKER_FAILURES=5
MARKETPLACE_BREAKER_COOLDOWN_MS=30000

# Order polling (ADR-0010): interval, overlap with the previous poll, how far back the first poll looks
ORDER_POLL_INTERVAL_MS=5000
ORDER_POLL_OVERLAP_MS=60000
ORDER_POLL_LOOKBACK_MS=86400000

# Topics the service consumes, and the dead letter topic of the cancellations
ORDER_CANCELLED_TOPIC=order.order.cancelled.v1
ORDER_CANCELLED_DLQ_TOPIC=marketplace.order-cancelled.dlq
