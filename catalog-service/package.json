{
  "name": "catalog-service",
  "version": "1.0.0",
  "description": "omni-market catalog service",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --require ./src/infra/observability/instrumentation.ts src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env --require ./dist/infra/observability/instrumentation.js dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "knex": "tsx --env-file-if-exists=.env node_modules/knex/bin/cli.js --knexfile knexfile.ts",
    "migrate": "tsx --env-file-if-exists=.env src/infra/persistence/migrate.ts",
    "migrate:rollback": "npm run knex -- migrate:rollback",
    "migrate:status": "npm run knex -- migrate:status",
    "migrate:make": "npm run knex -- migrate:make -x ts --migrations-directory src/infra/persistence/migrations",
    "migrate:deploy": "node dist/infra/persistence/migrate.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "express": "^5.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^13.0.3",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
