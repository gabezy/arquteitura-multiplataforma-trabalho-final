# Variables read by the service (see internal/infra/config). To run it from this
# directory against `make up-infra`: set -a; . ./.env; set +a; go run ./cmd/billing-service
PORT=8086
LOG_LEVEL=info
OTEL_SERVICE_NAME=billing-service
OTEL_COLLECTOR_URL=http://localhost:4318
DATABASE_URL=postgresql://billing:billing@localhost:5435/billing
KAFKA_BROKERS=localhost:9092
OUTBOX_POLL_INTERVAL=1s
