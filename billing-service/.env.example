# Variables read by the service (see internal/infra/config). To run it from this
# directory against `make up-infra`: set -a; . ./.env; set +a; go run ./cmd/billing-service
PORT=8086
LOG_LEVEL=info
OTEL_SERVICE_NAME=billing-service
OTEL_COLLECTOR_URL=http://localhost:4318
DATABASE_URL=postgresql://billing:billing@localhost:5435/billing
KAFKA_BROKERS=localhost:9092
OUTBOX_POLL_INTERVAL=1s
PSP_BASE_URL=http://localhost:8089
# Where the WireMock container reaches this service when it runs on the host.
PSP_CALLBACK_URL=http://host.docker.internal:8086/webhooks/psp
# The WireMock mappings send this token back, so it stays fixed while the PSP is the simulator.
PSP_WEBHOOK_TOKEN=psp-demo-token
PAYMENT_POLL_INTERVAL=2s
RECONCILE_INTERVAL=30s
# How long a charge waits for its webhook before it is asked about.
RECONCILE_AFTER=60s
