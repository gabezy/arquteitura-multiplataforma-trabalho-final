      "request": {
        "method": "POST",
        "urlPathPattern": "/amazon/orders/v0/orders/[^/]*UNKNOWN[^/]*/cancellation"
      },
      "response": {
        "status": 404,
        "headers": { "Content-Type": "application/json" },
        "jsonBody": { "errors": [{ "code": "NotFound", "message": "Order not found" }] }
      }
    },
    {
