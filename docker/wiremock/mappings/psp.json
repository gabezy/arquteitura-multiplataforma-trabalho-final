{
    "mappings": [
        {
            "id": "11111111-aaaa-4aaa-8aaa-000000000001",
            "name": "PSP: cobrança recusada por saldo (a partir de R$ 100.000,00)",
            "priority": 1,
            "request": {
                "method": "POST",
                "urlPath": "/psp/v1/charges",
                "bodyPatterns": [
                    { "matchesJsonPath": "$[?(@.amount >= 10000000)]" }
                ]
            },
            "response": {
                "status": 201,
                "headers": { "Content-Type": "application/json" },
                "jsonBody": {
                    "id": "ch_failed_{{jsonPath request.body '$.reference'}}",
                    "reference": "{{jsonPath request.body '$.reference'}}",
                    "status": "PENDING"
                },
                "transformers": ["response-template"]
            },
            "serveEventListeners": [
                {
                    "name": "webhook",
                    "parameters": {
                        "method": "POST",
                        "url": "{{jsonPath originalRequest.body '$.callbackUrl'}}",
                        "headers": { "Content-Type": "application/json", "X-PSP-Token": "psp-demo-token" },
                        "delay": { "type": "fixed", "milliseconds": 2000 },
                        "body": "{ \"chargeId\": \"ch_failed_{{jsonPath originalRequest.body '$.reference'}}\", \"reference\": \"{{jsonPath originalRequest.body '$.reference'}}\", \"status\": \"FAILED\", \"failureReason\": \"INSUFFICIENT_FUNDS\", \"occurredAt\": \"{{now format='yyyy-MM-dd\\'T\\'HH:mm:ss\\'Z\\''}}\" }"
                    }
                }
            ]
        },
        {
            "id": "11111111-aaaa-4aaa-8aaa-000000000002",
            "name": "PSP: cobrança aprovada",
            "priority": 5,
            "request": {
                "method": "POST",
                "urlPath": "/psp/v1/charges"
            },
            "response": {
                "status": 201,
                "headers": { "Content-Type": "application/json" },
                "jsonBody": {
                    "id": "ch_paid_{{jsonPath request.body '$.reference'}}",
                    "reference": "{{jsonPath request.body '$.reference'}}",
                    "status": "PENDING"
                },
                "transformers": ["response-template"]
            },
            "serveEventListeners": [
                {
                    "name": "webhook",
                    "parameters": {
                        "method": "POST",
                        "url": "{{jsonPath originalRequest.body '$.callbackUrl'}}",
                        "headers": { "Content-Type": "application/json", "X-PSP-Token": "psp-demo-token" },
                        "delay": { "type": "fixed", "milliseconds": 2000 },
                        "body": "{ \"chargeId\": \"ch_paid_{{jsonPath originalRequest.body '$.reference'}}\", \"reference\": \"{{jsonPath originalRequest.body '$.reference'}}\", \"status\": \"PAID\", \"failureReason\": null, \"occurredAt\": \"{{now format='yyyy-MM-dd\\'T\\'HH:mm:ss\\'Z\\''}}\" }"
                    }
                }
            ]
        },
        {
            "id": "11111111-aaaa-4aaa-8aaa-000000000003",
            "name": "PSP: consulta de cobrança aprovada",
            "request": {
                "method": "GET",
                "urlPathPattern": "/psp/v1/charges/ch_paid_[0-9a-f-]{36}"
            },
            "response": {
                "status": 200,
                "headers": { "Content-Type": "application/json" },
                "jsonBody": {
                    "id": "{{request.pathSegments.[3]}}",
                    "reference": "{{regexExtract request.pathSegments.[3] '[0-9a-f-]{36}$'}}",
                    "status": "PAID",
                    "failureReason": null
                },
                "transformers": ["response-template"]
            }
        },
        {
            "id": "11111111-aaaa-4aaa-8aaa-000000000004",
            "name": "PSP: consulta de cobrança recusada",
            "request": {
                "method": "GET",
                "urlPathPattern": "/psp/v1/charges/ch_failed_[0-9a-f-]{36}"
            },
            "response": {
                "status": 200,
                "headers": { "Content-Type": "application/json" },
                "jsonBody": {
                    "id": "{{request.pathSegments.[3]}}",
                    "reference": "{{regexExtract request.pathSegments.[3] '[0-9a-f-]{36}$'}}",
                    "status": "FAILED",
                    "failureReason": "INSUFFICIENT_FUNDS"
                },
                "transformers": ["response-template"]
            }
        },
        {
            "id": "11111111-aaaa-4aaa-8aaa-000000000005",
            "name": "PSP: cobrança desconhecida",
            "priority": 10,
            "request": {
                "method": "GET",
                "urlPathPattern": "/psp/v1/charges/.*"
            },
            "response": {
                "status": 404,
                "headers": { "Content-Type": "application/json" },
                "jsonBody": { "code": "CHARGE_NOT_FOUND" }
            }
        }
    ]
}
