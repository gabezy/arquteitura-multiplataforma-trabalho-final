    {
      "id": "cc000000-0000-4000-8000-000000000024",
      "name": "shopee: consulta o anúncio (get_item_base_info, um item_id por chamada)",
      "priority": 5,
      "request": {
        "method": "GET",
        "urlPath": "/shopee/api/v2/product/get_item_base_info",
        "queryParameters": { "item_id_list": { "matches": "[0-9]+" } }
      },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "bodyFileName": "shopee/get-item.json",
